    {
      "id": "f:link",
      "type": "text",
      "variant": "default",
      "label": "Instagram media link",
      "name": "link",
      "bind_id": "t:root",
      "required": true,
      "defaults": {
        "placeholder": "Paste an Instagram link"
      },
      "validation": [
        {
          "op": "match",
          "pattern": "^https?://(?:www\\.|m\\.)?instagram\\.com/\\S+$",
          "pattern_flags": "i",
          "message": "Enter an Instagram media link."
        }
      ]
    },
    {
      "id": "f:quantity",
      "type": "number",
      "variant": "default",
      "label": "Quantity",
      "name": "quantity",
      "bind_id": "t:root",
      "required": true,
      "defaults": {
        "placeholder": "e.g. 1,000",
        "step": 1,
        "tags": [
          {
            "label": "Min: {preview.min ?? \"—\"}"
          },
          {
            "label": "Max: {preview.max ?? \"—\"}"
          }
        ]
      },
      "pricing_role": "base",
      "quantity": {
        "value_by": "value"
      },
      "validation": [
        {
          "value_by": "eval",
          "expression": {
            "language": "javascript",
            "body": "return Number.isInteger(Number(value)) && Number(value) > 0;"
          },
          "op": "truthy",
          "message": "Enter a positive whole number."
        }
      ]
    },
    {
      "id": "f:drip_feed",
      "type": "toggle",
      "variant": "default",
      "label": "Drip feed",
      "description": "Schedule multiple deliveries by setting the number of runs and the minutes between them.",
      "name": "drip_feed",
      "bind_id": "t:root",
      "button": true,
      "visibility_expression": {
        "language": "javascript",
        "body": "preview.service_context.length > 0 && preview.service_context.every(service => service.capabilities?.dripfeed?.enabled === true)"
      }
    },
    {
      "id": "f:runs",
      "type": "number",
      "variant": "default",
      "label": "Runs",
      "name": "runs",
      "required": true,
      "defaults": {
        "placeholder": "e.g. 5"
      },
      "validation": [
        {
          "value_by": "eval",
          "expression": {
            "language": "javascript",
            "body": "return Number.isInteger(Number(value)) && Number(value) > 0;"
          },
          "op": "truthy",
          "message": "Enter a positive whole number."
        }
      ]
    },
    {
      "id": "f:interval",
      "type": "number",
      "variant": "default",
      "label": "Interval (minutes)",
      "name": "interval",
      "required": true,
      "defaults": {
        "placeholder": "e.g. 60"
      },
      "validation": [
        {
          "value_by": "eval",
          "expression": {
            "language": "javascript",
            "body": "return Number.isInteger(Number(value)) && Number(value) > 0;"
          },
          "op": "truthy",
          "message": "Enter a positive whole number."
        }
      ]
    }

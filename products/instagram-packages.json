    {
      "id": "f:comments",
      "type": "chips",
      "variant": "default",
      "label": "Custom comments",
      "bind_id": [
        "t:custom-comment-bundles",
        "t:timed-packages"
      ],
      "name": "comments",
      "required": true,
      "defaults": {
        "placeholder": "Type a comment and press Enter",
        "textareaMode": true,
        "separators": [
          "Enter"
        ],
        "allowDuplicates": true
      },
      "validation": [
        {
          "value_by": "eval",
          "expression": {
            "language": "javascript",
            "body": "return values.length > 0 && values.every(comment => typeof comment === \"string\" && comment.trim() !== \"\" && !/[\\r\\n]/.test(comment));"
          },
          "op": "truthy",
          "message": "Enter one non-empty comment per chip."
        }
      ]
    },
    {
      "id": "f:quantity",
      "type": "number",
      "variant": "default",
      "label": "Quantity",
      "bind_id": "t:recent-post-likes",
      "name": "quantity",
      "required": true,
      "defaults": {
        "placeholder": "Enter a quantity",
        "step": 1,
        "tags": [
          {
            "label": "Min: {preview.min ?? \"—\"}"
          },
          {
            "label": "Max: {preview.max ?? \"—\"}"
          }
        ]
      },
      "pricing_role": "base",
      "quantity": {
        "value_by": "value"
      },
      "validation": [
        {
          "value_by": "eval",
          "expression": {
            "language": "javascript",
            "body": "return Number.isInteger(Number(value)) && Number(value) > 0;"
          },
          "op": "truthy",
          "message": "Enter a positive whole number."
        }
      ]
    }

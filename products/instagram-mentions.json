      ]
    },
    {
      "id": "f:link",
      "type": "text",
      "variant": "default",
      "label": "Destination Instagram link",
      "name": "link",
      "required": true,
      "defaults": {
        "placeholder": "Paste the destination Instagram link"
      },
      "bind_id": "t:root"
    },
    {
      "id": "f:quantity",
      "type": "number",
      "variant": "default",
      "label": "Quantity",
      "name": "quantity",
      "required": true,
      "defaults": {
        "placeholder": "Enter the number of mentions",
        "step": 1,
        "tags": [
          {
            "label": "Min: {preview.min ?? \"—\"}"
          },
          {
            "label": "Max: {preview.max ?? \"—\"}"
          }
        ]
      },
      "pricing_role": "base",
      "quantity": {
        "value_by": "value"
      },
      "validation": [
        {
          "value_by": "eval",
          "expression": {
            "language": "javascript",
            "body": "return Number.isInteger(Number(value)) && Number(value) > 0;"
          },
          "op": "truthy",
          "message": "Enter a positive whole number."
        }
      ]
    },
    {
      "id": "f:usernames",
      "type": "chips",
      "variant": "default",
      "label": "Usernames",
      "name": "usernames",
      "required": true,
      "defaults": {
        "placeholder": "Type a username and press Enter",
        "separators": [
          "Enter"
        ],
        "allowDuplicates": true,
        "textareaMode": true
      },
      "pricing_role": "base",
      "quantity": {
        "value_by": "length"
      },
      "visibility_expression": {
        "language": "javascript",
        "body": "preview.selection.trigger_ids.some(id => [\"o:custom-list:50k-day\", \"o:custom-list:10k-day-higher-limit\", \"o:custom-list:10k-day\", \"o:reels:custom-list\", \"o:hashtags:multiple-hashtags-usernames\", \"o:others:custom-list-five-person\", \"o:others:custom-list-single-person\"].includes(id))"
      },
      "validation": [
        {
          "value_by": "eval",
          "expression": {
            "language": "javascript",
            "body": "return values.length > 0 && values.every(username => typeof username === \"string\" && /^[^\\s,;]+$/.test(username));"
          },
          "op": "truthy",
          "message": "Enter one username per chip without spaces, commas, or semicolons."
        }
      ]
    },
    {
      "id": "f:username",
      "type": "text",
      "variant": "default",
      "label": "Source account or location",
      "name": "username",
      "required": true,
      "defaults": {
        "placeholder": "Enter the source profile URL or location value"
      },
      "description": "For account-follower options, use the source Instagram profile URL."
    },
    {
      "id": "f:hashtag",
      "type": "text",
      "variant": "default",
      "label": "Hashtag",
      "name": "hashtag",
      "required": true,
      "defaults": {
        "placeholder": "Enter one hashtag"
      }
    },
    {
      "id": "f:hashtags",
      "type": "chips",
      "variant": "default",
      "label": "Hashtags",
      "name": "hashtags",
      "required": true,
      "defaults": {
        "placeholder": "Type a hashtag and press Enter",
        "separators": [
          "Enter"
        ],
        "allowDuplicates": true,
        "textareaMode": true
      },
      "validation": [
        {
          "value_by": "eval",
          "expression": {
            "language": "javascript",
            "body": "return values.length > 0 && values.every(hashtag => typeof hashtag === \"string\" && /^[^\\s,;]+$/.test(hashtag));"
          },
          "op": "truthy",
          "message": "Enter one hashtag per chip without spaces, commas, or semicolons."
        }
      ]
    },
    {
      "id": "f:media",
      "type": "text",
      "variant": "default",
      "label": "Source Instagram post",
      "name": "media",
      "required": true,
      "defaults": {
        "placeholder": "Paste the source Instagram post link"
      }
    }
  ],
